{
  "name": "moneyprint-remotion-adapter",
  "private": true,
  "version": "1.0.0",
  "description": "Explicit optional Remotion renderer; does not belong to open-source MoneyPrint core",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx MoneyPrint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/media": "4.0.542",
    "remotion": "4.0.542",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "typescript": "5.9.3"
  }
}
